# API server
PORT=5001
CLIENT_URL=http://localhost:5173
NODE_ENV=development
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
MONGODB_URI=mongodb://127.0.0.1:27017/sacoe

# Set both only for the first administrator bootstrap; remove them after creation.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional enquiry notifications
NOTIFICATION_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional Cloudinary account (image upload endpoint is not enabled yet)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
